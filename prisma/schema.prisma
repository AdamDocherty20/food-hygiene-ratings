// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Establishment {
  id Int @id @default(autoincrement())

  // FSA's stable national identifier
  fhrsId Int @unique

  // Local authority's own identifier; unique only within that authority
  localAuthorityBusinessId String

  businessName   String
  businessType   String
  businessTypeId Int

  addressLine1 String?
  addressLine2 String?
  addressLine3 String?
  addressLine4 String?
  postcode     String?

  // "0"-"5" for FHRS, or a status string ("Pass", "Improvement Required",
  // "Awaiting Inspection", "Exempt", "Awaiting Publication") for FHIS
  ratingValue String
  ratingKey   String
  ratingDate  DateTime?

  schemeType String

  latitude  Float?
  longitude Float?

  localAuthorityName String
  localAuthorityCode String

  // Soft-delete flag for establishments that drop out of the FSA feed
  isActive Boolean @default(true)

  // Updated on every sync run in which this record appears
  lastSeenAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postcode])
  @@index([latitude, longitude])
}

// One row per detected rating change (including the very first rating an establishment
// is seen with), written by the sync script whenever a re-run's ratingValue/ratingDate
// differs from what's currently stored. Deliberately not a foreign key to Establishment —
// establishments are soft-deleted (isActive), never removed, so there's no cascade to
// worry about, and keeping this table decoupled means the bulk upsert in sync.ts doesn't
// need to join against it.
model RatingHistory {
  id Int @id @default(autoincrement())

  fhrsId Int

  ratingValue String
  schemeType  String
  ratingDate  DateTime?

  // When *we* observed this rating (i.e. sync run time), not the FSA's inspection date —
  // ratingDate above is the inspection date and can be null/backdated.
  recordedAt DateTime @default(now())

  @@index([fhrsId, recordedAt])
}

// One row per FSA establishment successfully matched against a Companies House company —
// written by scripts/match-companies-house.ts. Deliberately holds only the match *result*
// (a handful of fields), not the full ~5.5m-row Companies House register: the free monthly
// snapshot is small enough (469MB zipped) to re-download and re-process from scratch on
// every run instead of persisting it, which keeps this table (and the free-tier DB storage
// it uses) proportional to our own 600k+ establishments rather than the whole UK register.
// Re-tuning the matching logic means re-running the script, not a bigger backfill.
//
// Only HIGH and MEDIUM confidence matches are ever surfaced as page content — see
// `publishable`. LOW is kept for analysis but never shown to a visitor as fact.
model CompanyMatch {
  id Int @id @default(autoincrement())

  fhrsId Int @unique

  companyNumber     String
  companyName       String
  incorporationDate DateTime?
  companyStatus     String?
  sicCodes          String[]

  // "HIGH" | "MEDIUM" | "LOW" — see scripts/match-companies-house.ts for the exact rules.
  matchConfidence String
  publishable     Boolean

  source      String
  licence     String
  retrievedAt DateTime

  matchedAt DateTime @default(now())

  @@index([matchConfidence])
}

// One row per FSA establishment matched to a UK restaurant/café/pub/supermarket/bakery
// chain on Wikidata — written by scripts/match-wikidata.ts. Only ~231 UK chains exist in
// the classes queried, so unlike CompanyMatch there's no storage-size reason not to persist
// the small source list too, but it's re-fetched fresh each run rather than cached in the
// DB anyway, since a single SPARQL query is cheap and this keeps the script simple.
//
// Matching is exact-name-or-alias only (see the brief's "Costa Coffee Ltd is Costa, but The
// Costa Del Sol Fish Bar is not" caution) — deliberately conservative, so every row here is
// trustworthy enough to publish directly (no LOW/unpublishable tier the way Companies House
// has one, since fuzzy matching was never attempted).
model ChainMatch {
  id Int @id @default(autoincrement())

  fhrsId Int @unique

  wikidataId    String
  chainName     String
  foundedDate   DateTime?
  headquarters  String?
  website       String?

  source      String
  licence     String
  retrievedAt DateTime

  matchedAt DateTime @default(now())
}

// One row per FSA establishment matched to an OpenStreetMap point — written by
// scripts/match-osm.ts, from Geofabrik's Great Britain extract filtered with osmium
// (see that script for why: the live Overpass API proved unreliable for bulk country-wide
// queries even scoped to one tag).
//
// Two distinct match methods, tracked in `matchMethod`:
//   "fhrs_id" — the OSM point already carries the FSA's own fhrs:id tag (mappers
//               cross-reference this directly) — exact, unambiguous, ~49% of tagged points.
//   "spatial" — the brief's original approach for everything else: nearest named point
//               within 75m, disambiguated by name similarity. distanceMeters/nameScore are
//               only populated for this method, so the threshold can be retuned later
//               without re-running the whole match, per the brief.
//
// Licence is ODbL, which (unlike Companies House/Wikidata) carries a real attribution
// *requirement*, not just a courtesy — the site must render an attribution line on any
// page using these fields.
model OsmMatch {
  id Int @id @default(autoincrement())

  fhrsId Int @unique

  osmType String
  osmId   BigInt

  matchMethod    String
  distanceMeters Float?
  nameScore      Int?

  cuisine        String?
  openingHours   String?
  takeaway       String?
  delivery       String?
  outdoorSeating String?
  wheelchair     String?
  dietVegan      String?
  dietVegetarian String?
  dietHalal      String?
  website        String?
  phone          String?

  source      String
  licence     String
  retrievedAt DateTime

  matchedAt DateTime @default(now())

  @@index([matchMethod])
  @@index([cuisine])
  @@index([dietVegan])
  @@index([dietVegetarian])
}

// One row per FSA establishment we've ever looked up against the Google Places API (New)
// — written lazily by src/lib/google-places.ts the first time that establishment's detail
// page is rendered, not by a batch script (unlike the other match models above), since
// Place Photo requests are billed per-use and this app has 611k+ establishments. Only
// googlePlaceId is cached: Google's Places API (New) terms explicitly forbid caching photo
// *names* ("You cannot cache a photo name... the name can expire"), so the photo itself is
// always re-resolved via a fresh Place Details call at render time, not stored here.
// googlePlaceId is null when a search found no matching place — cached anyway so a
// business with no Google listing isn't re-searched on every page regeneration.
model PlacePhotoMatch {
  id Int @id @default(autoincrement())

  fhrsId        Int     @unique
  googlePlaceId String?

  matchedAt DateTime @default(now())
}

// A business owner/manager's request to claim an establishment listing — submitted via
// the public claim form (src/app/establishment/[id]/claim), reviewed manually by the site
// operator via the password-gated /admin/claims page. No self-serve accounts exist yet
// (deliberately, at this scale of demand — see BusinessProfile below for what happens
// after approval), so fhrsId is a loose reference like every other match table, not a
// hard FK — see OsmMatch's own comment for why.
model BusinessClaim {
  id Int @id @default(autoincrement())

  fhrsId Int

  claimantName  String
  claimantEmail String
  claimantPhone String?
  relationship  String
  message       String?

  // "pending" | "approved" | "rejected"
  status String @default("pending")

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([fhrsId])
  @@index([status])
}

// The actual owner-provided content shown on an establishment's page — populated by the
// site operator through /admin/establishment/[id] once a claim is approved and the owner
// has sent over their copy/photos (see BusinessClaim's comment for why this is manual
// rather than a self-serve owner-facing editor for now). Rendered content, not a
// moderation queue: whatever's here goes live immediately, since the claim approval step
// is the trust boundary, not each individual edit.
model BusinessProfile {
  id Int @id @default(autoincrement())

  fhrsId Int @unique

  description String?
  website     String?
  phone       String?
  photoUrls   String[]

  updatedAt DateTime @updatedAt
}

// Editorial content for /blog, written and published entirely through the password-gated
// /admin/blog editor — same single-operator model as BusinessProfile, no author accounts.
// `content` is Markdown, rendered with react-markdown on the public page rather than
// stored as HTML, so the editor stays a plain textarea with no rich-text/XSS surface to
// manage. `slug` is generated from the title once at creation and never changes after
// (see src/lib/blog.ts) so published post URLs never break under a later title edit.
model BlogPost {
  id Int @id @default(autoincrement())

  slug          String  @unique
  title         String
  excerpt       String
  content       String
  coverImageUrl String?

  // "draft" | "published" — draft posts 404 on the public site and are excluded from the
  // sitemap, but stay listed (with a "Draft" badge) in /admin/blog so they can be found
  // and finished later.
  status String @default("draft")

  // Set the first time a post transitions to "published" and left alone after — toggling
  // back to draft and republishing keeps the original date rather than bumping it, which
  // matches how a "just fixed a typo" re-save should behave for a blog.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}
